generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ExchangeName {
  BINANCE
}

enum ExchangeEnvironment {
  TESTNET
  LIVE
}

enum TradingMode {
  PAPER
  BINANCE_TESTNET
  BINANCE_LIVE
}

enum StrategyStatus {
  STOPPED
  RUNNING
  PAUSED
}

enum PositionStatus {
  OPEN
  CLOSING
  CLOSED
  ERROR
}

enum SubPositionStatus {
  OPEN
  CLOSED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  REJECTED
  FAILED
}

enum StrategyActionType {
  INITIAL_ENTRY
  DCA_ENTRY
  INDEPENDENT_ENTRY
  RECOVERY_DCA_ENTRY
  PARENT_EXIT
  INDEPENDENT_EXIT
}

enum StrategyActionStatus {
  PENDING
  SUBMITTED
  COMPLETED
  FAILED
  PERMANENTLY_FAILED
  CANCELLED
}

enum StrategyActionFailureCategory {
  NETWORK
  TIMEOUT
  RATE_LIMIT
  EXCHANGE_TEMPORARY
  VALIDATION
  AUTHENTICATION
  INSUFFICIENT_BALANCE
  UNKNOWN
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum BacktestRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BacktestTradeType {
  PARENT_ENTRY
  INDEPENDENT_ENTRY
  PARENT_EXIT
  INDEPENDENT_EXIT
}

model User {
  id                  String                    @id @default(uuid())
  email               String                    @unique
  passwordHash        String
  fullName            String
  role                UserRole                  @default(USER)
  exchangeCredentials ExchangeCredential[]
  strategies          TradingStrategy[]
  positions           TradingPosition[]
  orders              TradingOrder[]
  strategyActions     StrategyAction[]
  notifications       OperationalNotification[]
  backtestRuns        BacktestRun[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model ExchangeCredential {
  id            String              @id @default(uuid())
  userId        String
  exchange      ExchangeName
  environment   ExchangeEnvironment @default(TESTNET)
  apiKeyCipher  String
  secretCipher  String
  iv             String
  authTag        String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange, environment])
  @@index([userId])
}

model TradingStrategy {
  id                           String               @id @default(uuid())
  userId                       String
  name                         String
  symbol                       String
  exchange                     ExchangeName         @default(BINANCE)
  environment                  ExchangeEnvironment  @default(TESTNET)
  mode                         TradingMode           @default(PAPER)
  status                       StrategyStatus        @default(STOPPED)
  paperTrading                 Boolean               @default(true)
  riskBudgetQuote              Decimal               @db.Decimal(28, 8)
  baseOrderQuote               Decimal               @db.Decimal(28, 8)
  maxDcaOrders                 Int                   @default(8)
  dcaStepPercent               Decimal               @db.Decimal(10, 4)
  dcaMultiplier                Decimal               @default(1) @db.Decimal(10, 4)
  takeProfitPercent            Decimal               @db.Decimal(10, 4)
  independentFromLevel         Int                   @default(5)
  recoveryEnabled              Boolean               @default(true)
  recoveryMaxOrders            Int                   @default(5)
  recoveryStepPercents         Json                  @default("[5,8,12,18,25]")
  recoveryMultipliers          Json                  @default("[1,1.5,2,3,5]")
  recoveryTakeProfitPercent    Decimal               @default(1.5) @db.Decimal(10, 4)
  maxStrategyExposureQuote     Decimal?              @db.Decimal(28, 8)
  maxOrderQuote                Decimal?              @db.Decimal(28, 8)
  maxDailyRealizedLossQuote    Decimal?              @db.Decimal(28, 8)
  maxOpenParentPositions       Int                   @default(1)
  maxOpenIndependentPositions  Int                   @default(20)
  maxIndependentExposureQuote  Decimal?              @db.Decimal(28, 8)
  positions                    TradingPosition[]
  actions                      StrategyAction[]
  backtestRuns                 BacktestRun[]
  user                         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  @@index([userId, status])
  @@index([userId, mode, status])
  @@unique([userId, name])
}

model TradingPosition {
  id                String               @id @default(uuid())
  userId            String
  strategyId        String
  symbol            String
  status            PositionStatus       @default(OPEN)
  totalQuantity     Decimal              @default(0) @db.Decimal(28, 12)
  totalCostQuote    Decimal              @default(0) @db.Decimal(28, 8)
  averageEntryPrice Decimal              @default(0) @db.Decimal(28, 12)
  realizedPnlQuote  Decimal              @default(0) @db.Decimal(28, 8)
  dcaCount          Int                  @default(0)
  recoveryMode      Boolean              @default(false)
  recoveryDcaCount  Int                  @default(0)
  recoveryAnchorPrice Decimal?            @db.Decimal(28, 12)
  recoveryTakeProfitPrice Decimal?        @db.Decimal(28, 12)
  nextDcaPrice      Decimal?             @db.Decimal(28, 12)
  takeProfitPrice   Decimal?             @db.Decimal(28, 12)
  orders            TradingOrder[]
  subPositions      TradingSubPosition[]
  actions           StrategyAction[]
  strategy          TradingStrategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  openedAt          DateTime             @default(now())
  closedAt          DateTime?
  updatedAt         DateTime             @updatedAt

  @@index([strategyId, status])
  @@index([userId, status])
}

model TradingSubPosition {
  id               String            @id @default(uuid())
  positionId       String
  level            Int
  status           SubPositionStatus @default(OPEN)
  quantity         Decimal           @db.Decimal(28, 12)
  costQuote        Decimal           @db.Decimal(28, 8)
  entryPrice       Decimal           @db.Decimal(28, 12)
  takeProfitPrice  Decimal           @db.Decimal(28, 12)
  realizedPnlQuote Decimal           @default(0) @db.Decimal(28, 8)
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  position         TradingPosition   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  orders           TradingOrder[]
  actions          StrategyAction[]

  @@unique([positionId, level])
  @@index([positionId, status])
}

model TradingOrder {
  id                       String               @id @default(uuid())
  userId                   String
  positionId               String
  subPositionId            String?
  exchangeOrderId          String?
  clientOrderId            String               @unique
  side                     OrderSide
  type                     OrderType
  status                   OrderStatus          @default(PENDING)
  level                    Int                  @default(1)
  independent              Boolean              @default(false)
  quantity                 Decimal              @db.Decimal(28, 12)
  price                    Decimal?             @db.Decimal(28, 12)
  filledQuantity           Decimal              @default(0) @db.Decimal(28, 12)
  quoteAmount              Decimal              @default(0) @db.Decimal(28, 8)
  averageFillPrice         Decimal?             @db.Decimal(28, 12)
  accountedFilledQuantity  Decimal              @default(0) @db.Decimal(28, 12)
  accountedQuoteAmount     Decimal              @default(0) @db.Decimal(28, 8)
  errorMessage             String?
  strategyAction           StrategyAction?
  position                 TradingPosition      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  subPosition              TradingSubPosition?  @relation(fields: [subPositionId], references: [id], onDelete: SetNull)
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([positionId, status])
  @@index([subPositionId, status])
  @@index([userId, createdAt])
}

model StrategyAction {
  id               String                        @id @default(uuid())
  userId           String
  strategyId       String
  positionId       String?
  subPositionId    String?
  orderId          String?                       @unique
  actionKey        String                        @unique
  type             StrategyActionType
  status           StrategyActionStatus          @default(PENDING)
  failureCategory  StrategyActionFailureCategory?
  retryable        Boolean                       @default(false)
  attemptCount     Int                           @default(0)
  maxAttempts      Int                           @default(5)
  lastAttemptedAt  DateTime?
  nextRetryAt      DateTime?
  level            Int?
  independent      Boolean                       @default(false)
  side             OrderSide
  quantity         Decimal?                      @db.Decimal(28, 12)
  quoteAmount      Decimal?                      @db.Decimal(28, 8)
  triggerPrice     Decimal?                      @db.Decimal(28, 12)
  errorMessage     String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  completedAt      DateTime?
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy         TradingStrategy               @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  position         TradingPosition?              @relation(fields: [positionId], references: [id], onDelete: Cascade)
  subPosition      TradingSubPosition?           @relation(fields: [subPositionId], references: [id], onDelete: SetNull)
  order            TradingOrder?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([strategyId, status])
  @@index([status, nextRetryAt])
  @@index([userId, createdAt])
  @@index([positionId, status])
  @@index([subPositionId, status])
}

model HistoricalCandle {
  id        String       @id @default(uuid())
  exchange  ExchangeName @default(BINANCE)
  symbol    String
  interval  String
  openTime  DateTime
  closeTime DateTime
  open      Decimal      @db.Decimal(28, 12)
  high      Decimal      @db.Decimal(28, 12)
  low       Decimal      @db.Decimal(28, 12)
  close     Decimal      @db.Decimal(28, 12)
  volume    Decimal      @db.Decimal(36, 12)
  createdAt DateTime     @default(now())

  @@unique([exchange, symbol, interval, openTime])
  @@index([symbol, interval, openTime])
}

model BacktestRun {
  id                 String                @id @default(uuid())
  userId             String
  strategyId         String
  exchange           ExchangeName          @default(BINANCE)
  symbol             String
  interval           String
  startTime          DateTime
  endTime            DateTime
  status             BacktestRunStatus     @default(PENDING)
  initialCapital     Decimal               @db.Decimal(28, 8)
  endingCapital      Decimal?              @db.Decimal(28, 8)
  realizedPnlQuote   Decimal?              @db.Decimal(28, 8)
  returnPercent      Decimal?              @db.Decimal(12, 6)
  maxDrawdownPercent Decimal?              @db.Decimal(12, 6)
  tradeCount         Int                   @default(0)
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy           TradingStrategy       @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  trades             BacktestTrade[]
  equityPoints       BacktestEquityPoint[]

  @@index([userId, createdAt])
  @@index([strategyId, createdAt])
  @@index([status, createdAt])
}

model BacktestTrade {
  id               String            @id @default(uuid())
  runId            String
  type             BacktestTradeType
  level            Int
  independent      Boolean           @default(false)
  executedAt       DateTime
  price            Decimal           @db.Decimal(28, 12)
  quantity         Decimal           @db.Decimal(28, 12)
  quoteAmount      Decimal           @db.Decimal(28, 8)
  feeQuote         Decimal           @default(0) @db.Decimal(28, 8)
  realizedPnlQuote Decimal?          @db.Decimal(28, 8)
  run              BacktestRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())

  @@index([runId, executedAt])
  @@index([runId, type])
}

model BacktestEquityPoint {
  id           String      @id @default(uuid())
  runId        String
  recordedAt   DateTime
  equityQuote  Decimal     @db.Decimal(28, 8)
  drawdownPercent Decimal  @db.Decimal(12, 6)
  run          BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([runId, recordedAt])
  @@index([runId, recordedAt])
}

model OperationalNotification {
  id         String               @id @default(uuid())
  userId     String
  event      String
  message    String
  severity   NotificationSeverity
  strategyId String?
  positionId String?
  orderId    String?
  metadata   Json?
  createdAt  DateTime             @default(now())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([severity, createdAt])
}

model NotificationWebhookMetricsSnapshot {
  id             String   @id @default(uuid())
  attempted      Int      @default(0)
  delivered      Int      @default(0)
  failed         Int      @default(0)
  retried        Int      @default(0)
  lastAttemptAt  DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  lastStatusCode Int?
  recordedAt     DateTime @default(now())

  @@index([recordedAt])
}
